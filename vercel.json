{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/marcos/QuizMarcos.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=QuizMarcos.apk" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/noticias?cron=1", "schedule": "0 11 * * *" },
    { "path": "/api/noticias?cron=1", "schedule": "0 23 * * *" }
  ]
}
