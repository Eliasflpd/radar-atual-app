{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/hit",      "destination": "/api/dados?fn=hit" },
    { "source": "/api/hist",     "destination": "/api/dados?fn=hist" },
    { "source": "/api/igrejas",  "destination": "/api/dados?fn=igrejas" },
    { "source": "/api/acesso",   "destination": "/api/dados?fn=acesso" },
    { "source": "/api/ebd-lupa", "destination": "/api/dados?fn=ebd-lupa" },
    { "source": "/api/manual",   "destination": "/api/dados?fn=manual" },
    { "source": "/api/leitura",  "destination": "/api/dados?fn=leitura" },
    { "source": "/api/perolas",  "destination": "/api/edge?fn=perolas" },
    { "source": "/api/mensagem", "destination": "/api/edge?fn=mensagem" },
    { "source": "/api/concilio", "destination": "/api/edge?fn=concilio" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "crons": [
    { "path": "/api/noticias?cron=1", "schedule": "0 11 * * *" },
    { "path": "/api/noticias?cron=1", "schedule": "0 23 * * *" }
  ]
}
