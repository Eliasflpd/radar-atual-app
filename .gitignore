_BACKUP/

# Checkpoint do indexador da Busca por Significado (vetores crus em float32).
# São ~15 MB de arquivo binário que só servem pra retomar a indexação no PC.
# O que vai pro app é o resultado compacto em public/busca/.
scripts/.cache-busca/

# node_modules NUNCA vai pro git (entrou por engano em 21/09/2026 com um "git add -A")
node_modules/

# arquivos de teste com chave dentro (criados 21/09) — NUNCA pro git
scripts/.env-teste
scripts/.chaves-teste.json
# .env-vercel é despejo do "vercel env pull": traz BLOB_READ_WRITE_TOKEN e
# VERCEL_OIDC_TOKEN com valor real. Pega qualquer .env-* futuro em scripts/.
scripts/.env-*

